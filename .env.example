# TELEGRAM_BOT_TOKEN: Token Bot Telegram resmi dari @BotFather (contoh: 123456789:AAHxyz...)
# Dapat diisi melalui Secrets panel di AI Studio atau langsung melalui menu Pengaturan Admin di dalam aplikasi.
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN

# TELEGRAM_DEFAULT_CHAT_ID: Chat ID Grup / Channel atau Pejabat tujuan default di Telegram (contoh: -1001234567890 atau 987654321)
TELEGRAM_DEFAULT_CHAT_ID=YOUR_TELEGRAM_DEFAULT_CHAT_ID

# WHATSAPP_CLOUD_ACCESS_TOKEN: (Opsional) Token cadangan jembatan lintas platform
WHATSAPP_CLOUD_ACCESS_TOKEN=YOUR_WHATSAPP_CLOUD_ACCESS_TOKEN
WHATSAPP_PHONE_NUMBER_ID=YOUR_WHATSAPP_PHONE_NUMBER_ID
